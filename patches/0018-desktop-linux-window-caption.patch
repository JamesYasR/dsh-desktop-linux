+/** Window controls and corner geometry for the Linux caption, which the platform overlay cannot draw. */
+
+import { ipcRenderer } from 'electron'
+import { DESKTOP_IPC } from './ipc.ts'
+import { linuxWindowChromeArgument } from './linux-window.ts'
+import { resolveDesktopLocale } from './locale.ts'
+import { WINDOWS_TITLEBAR_HEIGHT } from './windows-layout.ts'
+
+// The frameless window paints no background of its own, so the radius clips the page and lets the
+// desktop show through the corners, which is how the platform rounds the macOS and Windows windows.
+const WINDOW_RADIUS = 12
+
+const GLYPH = {
+  minimize: '<svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 5h8" stroke="currentColor" stroke-width="1.2"/></svg>',
+  maximize: '<svg width="10" height="10" viewBox="0 0 10 10"><rect x="1.2" y="1.2" width="7.6" height="7.6" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>',
+  restore: '<svg width="10" height="10" viewBox="0 0 10 10"><rect x="1.2" y="2.8" width="6" height="6" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M3.4 2.8V1.9a.7.7 0 0 1 .7-.7h4.2a.7.7 0 0 1 .7.7v4.2a.7.7 0 0 1-.7.7h-.9" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>',
+  close: '<svg width="10" height="10" viewBox="0 0 10 10"><path d="M1.5 1.5l7 7M8.5 1.5l-7 7" stroke="currentColor" stroke-width="1.2"/></svg>',
+} as const
+
+/**
+ * Install the application-drawn window controls, and round the window for the frameless chrome.
+ *
+ * The caption chrome and the native chrome need neither: the overlay draws its own buttons, and the
+ * window manager draws both the titlebar and its controls.
+ * @returns Disposes every injected node.
+ */
+export function installLinuxCaption(): () => void {
+  if (process.platform !== 'linux') return () => {}
+  if (linuxWindowChromeArgument(process.argv) !== 'rounded') return () => {}
+
+  const style = document.createElement('style')
+  style.textContent = `
+    html, body { border-radius: ${WINDOW_RADIUS}px !important; }
+    html { background: transparent !important; }
+    body { overflow: hidden !important; }
+  `
+  document.head.append(style)
+
+  const host = document.createElement('div')
+  host.dataset.dshWindowControls = ''
+  const shadow = host.attachShadow({ mode: 'open' })
+  const controls = document.createElement('style')
+  controls.textContent = `
+    :host { position: fixed; top: 0; right: 0; z-index: 1200;
+      height: var(--dsh-windows-titlebar-height, ${WINDOWS_TITLEBAR_HEIGHT}px);
+      display: flex; align-items: center; gap: 2px; padding-right: 8px;
+      font-family: var(--dsw-font-family); -webkit-app-region: no-drag; }
+    button { width: 28px; height: 28px; display: grid; place-items: center; padding: 0;
+      border: 0; border-radius: 7px; background: transparent; color: var(--dsw-alias-label-secondary);
+      cursor: default; -webkit-app-region: no-drag; }
+    button:hover { background: var(--dsw-alias-interactive-bg-hover); color: var(--dsw-alias-label-primary); }
+    button[data-close]:hover { background: #e5484d; color: #ffffff; }
+    button:focus-visible { outline: 2px solid var(--dsw-alias-state-business-primary); outline-offset: -1px; }
+    svg { pointer-events: none; }
+  `
+  const { messages } = resolveDesktopLocale(document.documentElement.lang)
+  const bar = document.createElement('div')
+  const entries = [
+    { action: 'minimize', glyph: GLYPH.minimize, label: messages.windowMinimize },
+    { action: 'toggle-maximize', glyph: GLYPH.maximize, label: messages.windowMaximize },
+    { action: 'close', glyph: GLYPH.close, label: messages.windowClose },
+  ] as const
+  const nodes = entries.map(entry => {
+    const button = document.createElement('button')
+    button.type = 'button'
+    if (entry.action === 'close') button.dataset.close = ''
+    button.setAttribute('aria-label', entry.label)
+    button.innerHTML = entry.glyph
+    button.addEventListener('click', () => { ipcRenderer.send(DESKTOP_IPC.windowControl, entry.action) })
+    bar.append(button)
+    return { action: entry.action, button }
+  })
+  shadow.append(controls, bar)
+  document.body.append(host)
+
+  const maximum = nodes.find(node => node.action === 'toggle-maximize')
+  const onMaximized = (_event: Electron.IpcRendererEvent, maximized: boolean): void => {
+    if (maximum === undefined) return
+    maximum.button.innerHTML = maximized ? GLYPH.restore : GLYPH.maximize
+    maximum.button.setAttribute('aria-label', maximized ? messages.windowRestore : messages.windowMaximize)
+  }
+  ipcRenderer.on(DESKTOP_IPC.windowMaximized, onMaximized)
+  ipcRenderer.send(DESKTOP_IPC.windowControl, 'state')
+
+  return () => {
+    ipcRenderer.off(DESKTOP_IPC.windowMaximized, onMaximized)
+    host.remove()
+    style.remove()
+  }
+}
