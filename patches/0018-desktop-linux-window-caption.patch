+/** Linux window chrome shared by the main process and the application preload. */
+
+/** Environment variable that selects the Linux window chrome. */
+export const LINUX_WINDOW_CHROME_ENV = 'DSH_DESKTOP_LINUX_WINDOW_CHROME'
+
+/** Preload argument carrying the selected chrome into the application document. */
+export const LINUX_CHROME_ARGUMENT = '--dsh-linux-chrome='
+
+/**
+ * Linux window chrome.
+ * - `native` keeps the window manager's titlebar and the native menu bar.
+ * - `caption` hides the titlebar and lets the window-controls overlay draw the buttons, so the page
+ *   owns a caption strip identical to the Windows shell's.
+ * - `rounded` removes the frame entirely: the page draws its own controls and owns the window corners.
+ */
+export type LinuxWindowChrome = 'native' | 'caption' | 'rounded'
+
+/**
+ * Resolve the Linux window chrome this process uses.
+ * @param platform - Process platform; every other platform keeps its own chrome.
+ * @param environment - Environment carrying the opt-in selection.
+ * @returns Selected chrome, defaulting to the application caption.
+ */
+export function resolveLinuxWindowChrome(
+  platform = process.platform,
+  environment: NodeJS.ProcessEnv = process.env,
+): LinuxWindowChrome {
+  if (platform !== 'linux') return 'native'
+  const value = environment[LINUX_WINDOW_CHROME_ENV]?.trim()
+  if (value === undefined || value === '') return 'caption'
+  if (value === 'native' || value === 'caption' || value === 'rounded') return value
+  throw new Error(`desktop window: ${LINUX_WINDOW_CHROME_ENV} must be native, caption, or rounded`)
+}
+
+/**
+ * Read the chrome one application document was started with.
+ * @param argv - Renderer arguments, which carry the main process's selection.
+ * @returns Selected chrome, or undefined when the argument is absent or unrecognised.
+ */
+export function linuxWindowChromeArgument(argv: readonly string[]): LinuxWindowChrome | undefined {
+  const prefix = LINUX_CHROME_ARGUMENT
+  const argument = argv.find(value => value.startsWith(prefix))
+  if (argument === undefined) return undefined
+  const value = argument.slice(prefix.length)
+  return value === 'native' || value === 'caption' || value === 'rounded' ? value : undefined
+}
