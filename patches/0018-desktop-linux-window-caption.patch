diff --git a/apps/desktop/tests/linux-window.spec.ts b/apps/desktop/tests/linux-window.spec.ts
new file mode 100644
index 0000000..8a7466c
--- /dev/null
+++ b/apps/desktop/tests/linux-window.spec.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from 'vitest'
+import {
+  LINUX_CHROME_ARGUMENT,
+  LINUX_WINDOW_CHROME_ENV,
+  linuxWindowChromeArgument,
+  resolveLinuxWindowChrome,
+} from '../src/linux-window.ts'
+
+describe('Desktop Linux window chrome', () => {
+  it('keeps every other platform on its own chrome', () => {
+    expect(resolveLinuxWindowChrome('darwin', {})).toBe('native')
+    expect(resolveLinuxWindowChrome('win32', { [LINUX_WINDOW_CHROME_ENV]: 'rounded' })).toBe('native')
+  })
+
+  // 默认值决定产物开箱长什么样：上游的 GTK 标题栏与菜单栏对跨平台界面来说是多余的。
+  it('defaults to the application caption', () => {
+    expect(resolveLinuxWindowChrome('linux', {})).toBe('caption')
+    expect(resolveLinuxWindowChrome('linux', { [LINUX_WINDOW_CHROME_ENV]: '   ' })).toBe('caption')
+  })
+
+  it.each(['native', 'caption', 'rounded'] as const)('accepts %s', (chrome) => {
+    expect(resolveLinuxWindowChrome('linux', { [LINUX_WINDOW_CHROME_ENV]: ` ${chrome} ` })).toBe(chrome)
+  })
+
+  it('rejects an unrecognised selection instead of guessing', () => {
+    expect(() => resolveLinuxWindowChrome('linux', { [LINUX_WINDOW_CHROME_ENV]: 'frameless' }))
+      .toThrow(/must be native, caption, or rounded/u)
+  })
+})
+
+describe('Desktop Linux chrome argument', () => {
+  it('reads the selection the main process passed to the document', () => {
+    expect(linuxWindowChromeArgument([`${LINUX_CHROME_ARGUMENT}rounded`, '--other'])).toBe('rounded')
+    expect(linuxWindowChromeArgument([`${LINUX_CHROME_ARGUMENT}caption`])).toBe('caption')
+  })
+
+  it('ignores a missing or unrecognised argument', () => {
+    expect(linuxWindowChromeArgument(['--other'])).toBeUndefined()
+    expect(linuxWindowChromeArgument([`${LINUX_CHROME_ARGUMENT}unknown`])).toBeUndefined()
+  })
+})
