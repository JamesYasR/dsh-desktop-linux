+/** Linux package formats and the control metadata the Debian and RPM formats carry. */
+
+/** Environment variable that selects the Linux package formats one packaging run emits. */
+export const LINUX_FORMATS_ENV: string
+
+/** Environment variable that supplies the maintainer recorded in the Debian and RPM control files. */
+export const LINUX_MAINTAINER_ENV: string
+
+/** Environment variable that supplies the project URL recorded in the Debian and RPM control files. */
+export const LINUX_HOMEPAGE_ENV: string
+
+/** Maintainer and project URL recorded in a Debian or RPM control file. */
+export interface DesktopLinuxPackageMetadata {
+  maintainer: string
+  homepage: string
+}
+
+/**
+ * Resolve the Linux package formats this run emits.
+ * @param environment Packaging environment.
+ * @returns Format names in build order, without duplicates; AppImage unless configured.
+ */
+export function resolveDesktopLinuxFormats(environment?: NodeJS.ProcessEnv): string[]
+
+/**
+ * Resolve the control metadata the selected formats carry.
+ * @param environment File-owned release settings.
+ * @param formats Formats this run emits; defaults to the resolved selection.
+ * @returns Metadata, or undefined when no selected format carries any.
+ */
+export function resolveDesktopLinuxPackageMetadata(
+  environment?: NodeJS.ProcessEnv,
+  formats?: string[],
+): DesktopLinuxPackageMetadata | undefined
