--- /dev/null
+++ b/apps/desktop/tests/desktop-linux-packages.spec.ts
@@ -0,0 +1,75 @@
+import { describe, expect, it } from 'vitest'
+import {
+  LINUX_FORMATS_ENV,
+  LINUX_HOMEPAGE_ENV,
+  LINUX_MAINTAINER_ENV,
+  resolveDesktopLinuxFormats,
+  resolveDesktopLinuxPackageMetadata,
+} from '../scripts/desktop-linux-packages.mjs'
+
+const MAINTAINER = 'ffyfox <299493445+ffyfox@users.noreply.github.com>'
+const HOMEPAGE = 'https://github.com/deepseek-ai/deepseek-harness'
+const METADATA = { [LINUX_MAINTAINER_ENV]: MAINTAINER, [LINUX_HOMEPAGE_ENV]: HOMEPAGE }
+
+describe('Desktop Linux package formats', () => {
+  it('emits AppImage alone unless the run selects formats', () => {
+    expect(resolveDesktopLinuxFormats({})).toEqual(['AppImage'])
+    expect(resolveDesktopLinuxFormats({ [LINUX_FORMATS_ENV]: '   ' })).toEqual(['AppImage'])
+  })
+
+  it('reads the selection in build order without duplicates', () => {
+    expect(resolveDesktopLinuxFormats({ [LINUX_FORMATS_ENV]: 'AppImage,deb,rpm' })).toEqual(['AppImage', 'deb', 'rpm'])
+    expect(resolveDesktopLinuxFormats({ [LINUX_FORMATS_ENV]: ' deb , deb ,rpm ' })).toEqual(['deb', 'rpm'])
+  })
+
+  it.each(['deb,', ',deb', 'deb,,rpm', ','])('rejects the empty entry in %j', (value) => {
+    expect(() => resolveDesktopLinuxFormats({ [LINUX_FORMATS_ENV]: value })).toThrow(/without empty entries/u)
+  })
+})
+
+describe('Desktop Linux package metadata', () => {
+  it('requires nothing from the formats that carry no control file', () => {
+    expect(resolveDesktopLinuxPackageMetadata({}, ['AppImage'])).toBeUndefined()
+    expect(resolveDesktopLinuxPackageMetadata(METADATA, [])).toBeUndefined()
+  })
+
+  it.each(['deb', 'rpm', 'AppImage,rpm'])('resolves the maintainer and project URL for %s', (selection) => {
+    expect(resolveDesktopLinuxPackageMetadata(METADATA, selection.split(',')))
+      .toEqual({ maintainer: MAINTAINER, homepage: HOMEPAGE })
+  })
+
+  it('takes the format selection from the environment when none is passed', () => {
+    expect(resolveDesktopLinuxPackageMetadata(METADATA)).toBeUndefined()
+    expect(resolveDesktopLinuxPackageMetadata({ ...METADATA, [LINUX_FORMATS_ENV]: 'deb' }))
+      .toEqual({ maintainer: MAINTAINER, homepage: HOMEPAGE })
+  })
+
+  it.each(['', '   ', 'ffyfox', 'ffyfox@users.noreply.github.com', '<ffyfox@users.noreply.github.com>', 'ffyfox <not-an-address>'])(
+    'rejects maintainer %j',
+    (maintainer) => {
+      expect(() => resolveDesktopLinuxPackageMetadata({ ...METADATA, [LINUX_MAINTAINER_ENV]: maintainer }, ['deb']))
+        .toThrow(/DSH_DESKTOP_LINUX_MAINTAINER/u)
+    },
+  )
+
+  it.each(['', 'not-a-url', 'github.com/deepseek-ai/deepseek-harness', 'ftp://example.com/', 'mailto:someone@example.com'])(
+    'rejects homepage %j',
+    (homepage) => {
+      expect(() => resolveDesktopLinuxPackageMetadata({ ...METADATA, [LINUX_HOMEPAGE_ENV]: homepage }, ['rpm']))
+        .toThrow(/DSH_DESKTOP_LINUX_HOMEPAGE/u)
+    },
+  )
+
+  it('accepts an http homepage and trims both values', () => {
+    expect(resolveDesktopLinuxPackageMetadata({
+      [LINUX_MAINTAINER_ENV]: `  ${MAINTAINER}  `, [LINUX_HOMEPAGE_ENV]: '  http://example.com/  ',
+    }, ['deb'])).toEqual({ maintainer: MAINTAINER, homepage: 'http://example.com/' })
+  })
+
+  it('names every missing setting and the formats that need it in one failure', () => {
+    expect(() => resolveDesktopLinuxPackageMetadata({}, ['deb', 'rpm']))
+      .toThrow(/deb and rpm carry a maintainer and a project URL:[\s\S]*MAINTAINER[\s\S]*HOMEPAGE/u)
+    expect(() => resolveDesktopLinuxPackageMetadata({}, ['rpm']))
+      .toThrow(/^desktop package: rpm carries a maintainer and a project URL:/u)
+  })
+})
