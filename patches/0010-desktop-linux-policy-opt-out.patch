+/**
+ * Report whether one release target embeds and polls the mandatory-update policy.
+ * The policy service identifies its Desktop clients as desktop-win or desktop-mac and has no Linux
+ * identity, and a Linux release carries no update channel, so no policy decision could drive an action.
+ * @param {NodeJS.Platform} platform Target platform.
+ * @returns {boolean} True when the target embeds the policy.
+ */
+export function desktopPlatformEmbedsPolicy(platform) {
+  return platform !== 'linux'
+}
