@@ -0,0 +1,178 @@
+/** Read the archived-version catalog that backs a user-selected rollback to an earlier release. */
+
+import { lt, valid } from 'semver'
+
+/** Environment variable that points a packaged Linux application at another update feed. */
+const LINUX_UPDATE_FEED_ENV = 'DSH_DESKTOP_LINUX_UPDATE_ORIGIN'
+
+/** One archived release the shell can install in place of the running version. */
+export interface DesktopRollbackVersion {
+  readonly version: string
+  readonly upstreamRef: string
+  /** Generic provider base URL of that release, used as the updater feed for the downgrade. */
+  readonly feedUrl: string
+  readonly releaseUrl: string
+  readonly publishedAt: string
+  /** Data-format versions the release declared; absent when the catalog predates these fields. */
+  readonly sessionFormatVersion?: number
+  readonly storageSchemaVersion?: number
+  readonly sessionQuerySchemaVersion?: number
+  /** Whether that release remembers a version pin; absent when the archived notes predate the field. */
+  readonly pinCapable?: boolean
+}
+
+/** Parsed `versions.json`, published beside the update feed by the release pipeline. */
+export interface DesktopRollbackCatalog {
+  readonly schemaVersion: 1
+  /** Newest archived version, which the feed currently serves. */
+  readonly current?: string
+  readonly versions: readonly DesktopRollbackVersion[]
+}
+
+/** Why a rollback target cannot be promised to read data written by the running version. */
+export type DesktopRollbackRisk = 'current-unknown' | 'format-unknown' | 'session-format' | 'storage-schema'
+
+/** Compatibility verdict for one rollback target; `safe` is false whenever a risk is reported. */
+export interface DesktopRollbackCompatibility {
+  readonly safe: boolean
+  readonly risks: readonly DesktopRollbackRisk[]
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function requiredString(value: unknown, field: string): string {
+  if (typeof value !== 'string' || value.trim() === '') {
+    throw new Error(`desktop rollback: ${field} must be a non-empty string`)
+  }
+  return value
+}
+
+function optionalCount(value: unknown, field: string): number | undefined {
+  if (value === undefined) return undefined
+  if (!Number.isInteger(value) || (value as number) < 0) {
+    throw new Error(`desktop rollback: ${field} must be a non-negative integer`)
+  }
+  return value as number
+}
+
+function stripTrailingSlashes(value: string): string {
+  return value.replace(/\/+$/u, '')
+}
+
+/**
+ * Validate the published catalog before any entry reaches the updater.
+ * @param value - Parsed `versions.json`.
+ * @returns Catalog with every entry validated; unknown schema versions reject instead of being guessed.
+ * @throws {Error} When the document or any listed version is unusable.
+ */
+export function parseDesktopRollbackCatalog(value: unknown): DesktopRollbackCatalog {
+  if (!record(value) || value.schemaVersion !== 1 || !Array.isArray(value.versions)) {
+    throw new Error('desktop rollback: unsupported version catalog')
+  }
+  const versions = value.versions.map((entry, index): DesktopRollbackVersion => {
+    if (!record(entry)) throw new Error(`desktop rollback: versions[${index}] must be an object`)
+    const version = requiredString(entry.version, `versions[${index}].version`)
+    if (valid(version) === null) throw new Error(`desktop rollback: versions[${index}].version is not a semantic version`)
+    const sessionFormatVersion = optionalCount(entry.sessionFormatVersion, `versions[${index}].sessionFormatVersion`)
+    const storageSchemaVersion = optionalCount(entry.storageSchemaVersion, `versions[${index}].storageSchemaVersion`)
+    const sessionQuerySchemaVersion = optionalCount(entry.sessionQuerySchemaVersion, `versions[${index}].sessionQuerySchemaVersion`)
+    if (entry.pinCapable !== undefined && typeof entry.pinCapable !== 'boolean') {
+      throw new Error(`desktop rollback: versions[${index}].pinCapable must be true or false`)
+    }
+    return {
+      version,
+      upstreamRef: requiredString(entry.upstreamRef, `versions[${index}].upstreamRef`),
+      feedUrl: stripTrailingSlashes(requiredString(entry.feedUrl, `versions[${index}].feedUrl`)),
+      releaseUrl: requiredString(entry.releaseUrl, `versions[${index}].releaseUrl`),
+      publishedAt: requiredString(entry.publishedAt, `versions[${index}].publishedAt`),
+      ...(sessionFormatVersion === undefined ? {} : { sessionFormatVersion }),
+      ...(storageSchemaVersion === undefined ? {} : { storageSchemaVersion }),
+      ...(sessionQuerySchemaVersion === undefined ? {} : { sessionQuerySchemaVersion }),
+      ...(entry.pinCapable === undefined ? {} : { pinCapable: entry.pinCapable }),
+    }
+  })
+  const current = value.current
+  // The pipeline writes null for a catalog with no archived versions yet.
+  if (current !== undefined && current !== null && (typeof current !== 'string' || valid(current) === null)) {
+    throw new Error('desktop rollback: current must be a semantic version')
+  }
+  return { schemaVersion: 1, ...(typeof current !== 'string' ? {} : { current }), versions }
+}
+
+/**
+ * List the archived versions a user may roll back to.
+ * @param catalog - Parsed version catalog.
+ * @param currentVersion - Version reported by the running application.
+ * @param limit - Maximum entries to offer, newest first.
+ * @returns Versions strictly older than the running one.
+ */
+export function resolveRollbackCandidates(
+  catalog: DesktopRollbackCatalog,
+  currentVersion: string,
+  limit = 6,
+): readonly DesktopRollbackVersion[] {
+  if (valid(currentVersion) === null || limit < 1) return []
+  return catalog.versions
+    .filter(entry => valid(entry.version) !== null && lt(entry.version, currentVersion))
+    .sort((left, right) => lt(left.version, right.version) ? 1 : -1)
+    .slice(0, limit)
+}
+
+/**
+ * Find the catalog entry that describes the running version.
+ * @param catalog - Parsed version catalog.
+ * @param version - Version reported by the running application.
+ * @returns Matching entry, or undefined when the running build was never archived.
+ */
+export function findCatalogVersion(catalog: DesktopRollbackCatalog, version: string): DesktopRollbackVersion | undefined {
+  return catalog.versions.find(entry => entry.version === version)
+}
+
+/**
+ * Compare a rollback target's data formats with the running version's.
+ * Older releases may predate a format generation, in which case data written by the newer shell may not
+ * open after the downgrade; missing fields cannot be promised either way.
+ * @param candidate - Version the user selected.
+ * @param current - Catalog entry of the running version, when the catalog lists it.
+ * @returns Verdict plus the concrete risks behind it.
+ */
+export function rollbackCompatibility(
+  candidate: DesktopRollbackVersion,
+  current: DesktopRollbackVersion | undefined,
+): DesktopRollbackCompatibility {
+  if (current === undefined) return { safe: false, risks: ['current-unknown'] }
+  const risks = new Set<DesktopRollbackRisk>()
+  for (const field of ['sessionFormatVersion', 'storageSchemaVersion'] as const) {
+    const target = candidate[field]
+    const running = current[field]
+    if (target === undefined || running === undefined) risks.add('format-unknown')
+    else if (target < running) risks.add(field === 'sessionFormatVersion' ? 'session-format' : 'storage-schema')
+  }
+  return { safe: risks.size === 0, risks: [...risks] }
+}
+
+/**
+ * Resolve the base URL that serves both the update feed and its version catalog.
+ * @param environment - Desktop process environment; a non-empty override wins over the packaged feed.
+ * @param appUpdateYml - Contents of the packaged `app-update.yml`, when the file exists.
+ * @returns Base URL without a trailing slash, or undefined when neither source names one.
+ */
+export function resolveRollbackOrigin(environment: NodeJS.ProcessEnv, appUpdateYml: string | undefined): string | undefined {
+  const override = environment[LINUX_UPDATE_FEED_ENV]?.trim()
+  if (override !== undefined && override !== '') return stripTrailingSlashes(override)
+  if (appUpdateYml === undefined) return undefined
+  const match = /^url:[ \t]*(.+?)[ \t]*$/mu.exec(appUpdateYml)
+  const value = match?.[1]?.trim().replace(/^['"]|['"]$/gu, '')
+  return value === undefined || value === '' ? undefined : stripTrailingSlashes(value)
+}
+
+/**
+ * Build the catalog URL that sits beside a feed base URL.
+ * @param origin - Base URL that serves the feed.
+ * @returns Absolute `versions.json` URL.
+ */
+export function versionCatalogUrl(origin: string): string {
+  return `${stripTrailingSlashes(origin)}/versions.json`
+}
