+import { describe, expect, it } from 'vitest'
+import {
+  findCatalogVersion,
+  parseDesktopRollbackCatalog,
+  resolveRollbackCandidates,
+  resolveRollbackOrigin,
+  rollbackCompatibility,
+  versionCatalogUrl,
+  type DesktopRollbackVersion,
+} from '../src/update-rollback.ts'
+
+const FEED = 'https://github.com/example/dsh/releases/download/dsh-v0.2.1-alpha.4'
+
+function entry(overrides: Partial<DesktopRollbackVersion> & { version: string }): Record<string, unknown> {
+  return {
+    upstreamRef: `dsh-v${overrides.version}`,
+    feedUrl: `${FEED}/`,
+    releaseUrl: 'https://github.com/example/dsh/releases/tag/dsh-v0.2.1-alpha.4',
+    publishedAt: '2026-10-16T04:00:00Z',
+    sessionFormatVersion: 4,
+    storageSchemaVersion: 1,
+    sessionQuerySchemaVersion: 8,
+    ...overrides,
+  }
+}
+
+function catalog(versions: unknown[], current: unknown = '0.2.1-alpha.4'): Record<string, unknown> {
+  return { schemaVersion: 1, current, versions }
+}
+
+/** Parse one catalog and return its first entry, failing the fixture when validation dropped it. */
+function first(value: unknown): DesktopRollbackVersion {
+  const parsed = parseDesktopRollbackCatalog(value)
+  const only = parsed.versions[0]
+  if (only === undefined) throw new Error('fixture produced no catalog entry')
+  return only
+}
+
+function version(overrides: Partial<DesktopRollbackVersion> & { version: string }): DesktopRollbackVersion {
+  return first(catalog([entry(overrides)]))
+}
+
+describe('version catalog validation', () => {
+  it('accepts a catalog and normalizes the feed base URL', () => {
+    const parsed = parseDesktopRollbackCatalog(catalog([entry({ version: '0.2.1-alpha.3' })]))
+    expect(parsed.schemaVersion).toBe(1)
+    expect(parsed.current).toBe('0.2.1-alpha.4')
+    expect(parsed.versions[0]).toEqual({
+      version: '0.2.1-alpha.3',
+      upstreamRef: 'dsh-v0.2.1-alpha.3',
+      feedUrl: FEED,
+      releaseUrl: 'https://github.com/example/dsh/releases/tag/dsh-v0.2.1-alpha.4',
+      publishedAt: '2026-10-16T04:00:00Z',
+      sessionFormatVersion: 4,
+      storageSchemaVersion: 1,
+      sessionQuerySchemaVersion: 8,
+    })
+  })
+
+  it('keeps absent format fields absent instead of guessing them', () => {
+    const bare = { version: '0.2.1-alpha.3', upstreamRef: 'dsh-v0.2.1-alpha.3', feedUrl: FEED,
+      releaseUrl: 'https://github.com/example/dsh/releases/tag/x', publishedAt: '2026-10-16T04:00:00Z' }
+    const parsed = parseDesktopRollbackCatalog(catalog([bare]))
+    expect(parsed.versions[0]).not.toHaveProperty('sessionFormatVersion')
+    expect(parsed.versions[0]).not.toHaveProperty('storageSchemaVersion')
+  })
+
+  it('reads the optional version-pin capability and omits an absent one', () => {
+    const parsed = parseDesktopRollbackCatalog(catalog([
+      entry({ version: '0.2.1-alpha.3', pinCapable: false }),
+      entry({ version: '0.2.1-alpha.2' }),
+    ]))
+    expect(parsed.versions[0]?.pinCapable).toBe(false)
+    expect(parsed.versions[1]).not.toHaveProperty('pinCapable')
+  })
+
+  it('omits an absent current version', () => {
+    expect(parseDesktopRollbackCatalog({ schemaVersion: 1, versions: [] })).toEqual({ schemaVersion: 1, versions: [] })
+  })
+
+  it('accepts the null current the pipeline writes for an empty catalog', () => {
+    expect(parseDesktopRollbackCatalog({ schemaVersion: 1, current: null, versions: [] }))
+      .toEqual({ schemaVersion: 1, versions: [] })
+  })
+
+  it.each([
+    ['unsupported schema', { schemaVersion: 2, versions: [] }],
+    ['missing versions', { schemaVersion: 1 }],
+    ['entry is not an object', catalog(['text'])],
+    ['missing feed URL', catalog([{ ...entry({ version: '0.2.1-alpha.3' }), feedUrl: undefined }])],
+    ['empty upstream ref', catalog([{ ...entry({ version: '0.2.1-alpha.3' }), upstreamRef: ' ' }])],
+    ['invalid version', catalog([entry({ version: 'not-a-version' })])],
+    ['invalid current', { schemaVersion: 1, current: 'nope', versions: [] }],
+    ['negative format', catalog([entry({ version: '0.2.1-alpha.3', sessionFormatVersion: -1 })])],
+    ['invalid pin capability', catalog([{ ...entry({ version: '0.2.1-alpha.3' }), pinCapable: 'yes' }])],
+    ['fractional format', catalog([entry({ version: '0.2.1-alpha.3', storageSchemaVersion: 1.5 })])],
+  ])('rejects %s', (_name, value) => {
+    expect(() => parseDesktopRollbackCatalog(value)).toThrow(/desktop rollback/u)
+  })
+})
+
+describe('rollback candidate selection', () => {
+  const parsed = parseDesktopRollbackCatalog(catalog([
+    entry({ version: '0.2.1-alpha.2' }),
+    entry({ version: '0.2.1-alpha.4' }),
+    entry({ version: '0.2.1-alpha.3' }),
+  ]))
+
+  it('offers only strictly older versions, newest first', () => {
+    expect(resolveRollbackCandidates(parsed, '0.2.1-alpha.4').map(item => item.version))
+      .toEqual(['0.2.1-alpha.3', '0.2.1-alpha.2'])
+  })
+
+  it('honours the limit and ignores an unparsable running version', () => {
+    expect(resolveRollbackCandidates(parsed, '0.2.1-alpha.4', 1).map(item => item.version)).toEqual(['0.2.1-alpha.3'])
+    expect(resolveRollbackCandidates(parsed, 'not-a-version')).toEqual([])
+  })
+
+  it('finds the entry of the running version and reports an unarchived one as absent', () => {
+    expect(findCatalogVersion(parsed, '0.2.1-alpha.3')?.upstreamRef).toBe('dsh-v0.2.1-alpha.3')
+    expect(findCatalogVersion(parsed, '0.2.1-alpha.9')).toBeUndefined()
+  })
+})
+
+describe('rollback data compatibility', () => {
+  const current = version({ version: '0.2.1-alpha.4' })
+
+  it('accepts a target that declares the same data formats', () => {
+    expect(rollbackCompatibility(version({ version: '0.2.1-alpha.3' }), current)).toEqual({ safe: true, risks: [] })
+  })
+
+  it('reports an older session format as a risk', () => {
+    expect(rollbackCompatibility(version({ version: '0.2.1-alpha.3', sessionFormatVersion: 3 }), current))
+      .toEqual({ safe: false, risks: ['session-format'] })
+  })
+
+  it('reports an older storage schema as a risk', () => {
+    expect(rollbackCompatibility(version({ version: '0.2.1-alpha.3', storageSchemaVersion: 0 }), current))
+      .toEqual({ safe: false, risks: ['storage-schema'] })
+  })
+
+  // The query cache is derived data that the older shell can rebuild, so its schema is not part of the guard.
+  it('ignores the derived query-cache schema and reports both durable risks together', () => {
+    expect(rollbackCompatibility(version({ version: '0.2.1-alpha.3', sessionQuerySchemaVersion: 1 }), current).safe).toBe(true)
+    expect(rollbackCompatibility(
+      version({ version: '0.2.1-alpha.2', sessionFormatVersion: 3, storageSchemaVersion: 0 }), current).risks)
+      .toEqual(['session-format', 'storage-schema'])
+  })
+
+  it('cannot promise anything without the running version or its declared formats', () => {
+    const bare = first(catalog([{
+      version: '0.2.1-alpha.3', upstreamRef: 'dsh-v0.2.1-alpha.3', feedUrl: FEED,
+      releaseUrl: 'https://github.com/example/dsh/releases/tag/x', publishedAt: '2026-10-16T04:00:00Z',
+    }]))
+    expect(rollbackCompatibility(bare, undefined)).toEqual({ safe: false, risks: ['current-unknown'] })
+    expect(rollbackCompatibility(bare, version({ version: '0.2.1-alpha.4' })))
+      .toEqual({ safe: false, risks: ['format-unknown'] })
+  })
+})
+
+describe('catalog origin resolution', () => {
+  const yml = 'provider: generic\nurl: https://github.com/example/dsh/releases/download/linux-latest\nchannel: nightly\n'
+
+  it('prefers a non-empty environment override over the packaged feed', () => {
+    expect(resolveRollbackOrigin({ DSH_DESKTOP_LINUX_UPDATE_ORIGIN: 'http://127.0.0.1:8899/' }, yml))
+      .toBe('http://127.0.0.1:8899')
+    expect(resolveRollbackOrigin({ DSH_DESKTOP_LINUX_UPDATE_ORIGIN: '   ' }, yml))
+      .toBe('https://github.com/example/dsh/releases/download/linux-latest')
+  })
+
+  it('reads the packaged feed, quoted or not, and reports an absent one', () => {
+    expect(resolveRollbackOrigin({}, yml)).toBe('https://github.com/example/dsh/releases/download/linux-latest')
+    expect(resolveRollbackOrigin({}, "url: 'https://example.test/feed/' \n")).toBe('https://example.test/feed')
+    expect(resolveRollbackOrigin({}, undefined)).toBeUndefined()
+    expect(resolveRollbackOrigin({}, 'provider: generic\n')).toBeUndefined()
+  })
+
+  it('builds the catalog URL beside the feed', () => {
+    expect(versionCatalogUrl('https://example.test/feed/')).toBe('https://example.test/feed/versions.json')
+  })
+})
