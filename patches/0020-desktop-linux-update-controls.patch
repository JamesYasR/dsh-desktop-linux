+  writeFileSync(path, JSON.stringify({ custom: 'preserve', updates: { channel: 'nightly' } }))
+  await Promise.all([
+    new DesktopUpdateSettings(userData, 'nightly').save('stable'),
+    writeDesktopUpdateSettings(userData, { automaticChecks: false, pinnedFeedUrl: 'https://example.test/archive' }),
+  ])
+  expect(JSON.parse(readFileSync(path, 'utf8'))).toEqual({ custom: 'preserve', updates: {
+    channel: 'stable', automaticChecks: false, pinnedFeedUrl: 'https://example.test/archive',
+  } })
+  await writeDesktopUpdateSettings(userData, { pinnedFeedUrl: undefined })
+  expect(JSON.parse(readFileSync(path, 'utf8')).updates).toEqual({ channel: 'stable', automaticChecks: false })
+})
