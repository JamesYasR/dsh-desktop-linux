+
+/**
+ * Persist update preferences without disturbing preferences the document owns elsewhere.
+ *
+ * The file is replaced atomically so a crash cannot leave half-written settings, and an unreadable or
+ * invalid document is left untouched instead of being overwritten with defaults.
+ * @param userData - Electron's userData directory, independent of DSH_HOME.
+ * @param patch - Update preferences to merge; `undefined` removes a key, which unpins a feed.
+ * @returns Settings read back from disk after the write.
+ * @throws {Error} When the existing document cannot be read or parsed, or the write fails.
+ */
+export function writeDesktopUpdateSettings(
+  userData: string,
+  patch: Partial<{ allowTestAuthPopupWindow: boolean, automaticChecks: boolean, pinnedFeedUrl: string | undefined }>,
+): DesktopSettings {
+  const directory = join(userData, 'desktop')
+  const path = join(directory, 'settings.json')
+  let document: Record<string, unknown> = {}
+  try {
+    const parsed: unknown = JSON.parse(readFileSync(path, 'utf8'))
+    if (!record(parsed)) throw new Error('expected a JSON object')
+    document = { ...parsed }
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') {
+      throw new Error(`desktop settings: refusing to overwrite unreadable ${path}`, { cause: error })
+    }
+  }
+  const updates = record(document.updates) ? { ...document.updates } : {}
+  Object.assign(updates, patch)
+  document.updates = updates
+  mkdirSync(directory, { recursive: true, mode: 0o700 })
+  const temporary = `${path}.tmp`
+  writeFileSync(temporary, `${JSON.stringify(document, null, 2)}\n`, { mode: 0o600 })
+  renameSync(temporary, path)
+  return readDesktopSettings(userData)
+}
