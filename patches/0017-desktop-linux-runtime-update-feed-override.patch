 const { autoUpdater } = electronUpdater
 
+/**
+ * Environment variable that points a packaged Linux application at another AppImage update feed.
+ *
+ * A packaged build embeds its feed URL in `app-update.yml`. Setting this variable at launch replaces
+ * that feed for this process, so one AppImage can serve a qualification feed and an operator can move
+ * the feed without rebuilding. Whoever starts the process therefore chooses which feed it trusts.
+ */
+const LINUX_UPDATE_FEED_ENV = 'DSH_DESKTOP_LINUX_UPDATE_ORIGIN'
+
+/** @returns The Linux feed override for this process, or undefined when the packaged feed applies. */
+function linuxUpdateFeedOverride(): string | undefined {
+  if (process.platform !== 'linux') return undefined
+  const value = process.env[LINUX_UPDATE_FEED_ENV]?.trim()
+  return value === undefined || value === '' ? undefined : value
+}
