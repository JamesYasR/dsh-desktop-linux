@@ -0,0 +1,37 @@
+/** Resolve the Linux AppImage update feed a build publishes and the packaged application polls. */
+
+/** Environment variable that supplies the Linux update feed URL. */
+export const LINUX_UPDATE_ORIGIN_ENV = 'DSH_DESKTOP_LINUX_UPDATE_ORIGIN'
+
+// Plain HTTP is accepted only for a loopback feed, which the local update qualification uses.
+const LOOPBACK_HOSTS = new Set(['127.0.0.1', 'localhost', '[::1]', '::1'])
+
+/**
+ * Resolve the generic update feed one Linux build embeds.
+ *
+ * Linux artifacts are unsigned and inherit no macOS or Windows update deployment, so an ordinary
+ * Linux build ships no updater: `publish` stays null and the shell finds no `app-update.yml`.
+ * Supplying the feed URL opts this build in. Electron-builder then writes `app-update.yml` and the
+ * channel metadata (`nightly-linux.yml`) beside the AppImage, and the packaged application polls
+ * that feed through electron-updater's AppImage updater, which replaces the running AppImage file.
+ * @param {NodeJS.ProcessEnv} environment - File-owned release settings.
+ * @returns {{ publicUrl: string } | undefined} Feed base URL without a trailing slash, or undefined when the build ships no updater.
+ */
+export function resolveDesktopLinuxUpdateConfig(environment = process.env) {
+  const value = environment[LINUX_UPDATE_ORIGIN_ENV]?.trim()
+  if (value === undefined || value === '') return undefined
+  let parsed
+  try {
+    parsed = new URL(value)
+  }
+  catch {
+    throw new Error(`desktop linux update: ${LINUX_UPDATE_ORIGIN_ENV} must be an absolute URL`)
+  }
+  if (parsed.protocol !== 'https:' && !(parsed.protocol === 'http:' && LOOPBACK_HOSTS.has(parsed.hostname))) {
+    throw new Error(`desktop linux update: ${LINUX_UPDATE_ORIGIN_ENV} must use HTTPS (HTTP is accepted only for a loopback host)`)
+  }
+  if (parsed.username !== '' || parsed.password !== '' || parsed.search !== '' || parsed.hash !== '') {
+    throw new Error(`desktop linux update: ${LINUX_UPDATE_ORIGIN_ENV} must not carry credentials, a query, or a fragment`)
+  }
+  return { publicUrl: parsed.href.replace(/\/+$/u, '') }
+}
