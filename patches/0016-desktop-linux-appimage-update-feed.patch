diff --git a/apps/desktop/tests/desktop-linux-update.spec.ts b/apps/desktop/tests/desktop-linux-update.spec.ts
new file mode 100644
index 00000000..f4b9107a
--- /dev/null
+++ b/apps/desktop/tests/desktop-linux-update.spec.ts
@@ -0,0 +1,43 @@
+import { describe, expect, it } from 'vitest'
+import { LINUX_UPDATE_ORIGIN_ENV, resolveDesktopLinuxUpdateConfig } from '../scripts/desktop-linux-update.mjs'
+
+const FEED = 'https://github.com/example/dsh-linux/releases/download/linux-latest'
+
+describe('Desktop Linux update feed', () => {
+  it('ships no updater unless the build names a feed', () => {
+    expect(resolveDesktopLinuxUpdateConfig({})).toBeUndefined()
+    expect(resolveDesktopLinuxUpdateConfig({ [LINUX_UPDATE_ORIGIN_ENV]: '   ' })).toBeUndefined()
+  })
+
+  it('returns the feed URL without a trailing slash', () => {
+    expect(resolveDesktopLinuxUpdateConfig({ [LINUX_UPDATE_ORIGIN_ENV]: FEED })).toEqual({ publicUrl: FEED })
+    expect(resolveDesktopLinuxUpdateConfig({ [LINUX_UPDATE_ORIGIN_ENV]: `${FEED}/` })).toEqual({ publicUrl: FEED })
+    expect(resolveDesktopLinuxUpdateConfig({ [LINUX_UPDATE_ORIGIN_ENV]: `  ${FEED}  ` })).toEqual({ publicUrl: FEED })
+  })
+
+  // 回环上的明文 HTTP 是本地更新验证用的；公网 feed 传的是可执行代码，必须是 HTTPS。
+  it('accepts plain HTTP on a loopback host only', () => {
+    expect(resolveDesktopLinuxUpdateConfig({ [LINUX_UPDATE_ORIGIN_ENV]: 'http://127.0.0.1:8899' }))
+      .toEqual({ publicUrl: 'http://127.0.0.1:8899' })
+    expect(resolveDesktopLinuxUpdateConfig({ [LINUX_UPDATE_ORIGIN_ENV]: 'http://localhost:8899' }))
+      .toEqual({ publicUrl: 'http://localhost:8899' })
+    expect(() => resolveDesktopLinuxUpdateConfig({ [LINUX_UPDATE_ORIGIN_ENV]: 'http://feed.example.com' }))
+      .toThrow(/must use HTTPS/u)
+    expect(() => resolveDesktopLinuxUpdateConfig({ [LINUX_UPDATE_ORIGIN_ENV]: 'ftp://feed.example.com' }))
+      .toThrow(/must use HTTPS/u)
+  })
+
+  it.each(['not a url', '/releases/latest', 'github.com/example/repo'])('rejects the relative value %j', (value) => {
+    expect(() => resolveDesktopLinuxUpdateConfig({ [LINUX_UPDATE_ORIGIN_ENV]: value }))
+      .toThrow(/must be an absolute URL/u)
+  })
+
+  it.each([
+    'https://user:secret@feed.example.com',
+    'https://feed.example.com/?channel=nightly',
+    'https://feed.example.com/#fragment',
+  ])('rejects the credentialed or qualified value %j', (value) => {
+    expect(() => resolveDesktopLinuxUpdateConfig({ [LINUX_UPDATE_ORIGIN_ENV]: value }))
+      .toThrow(/must not carry credentials, a query, or a fragment/u)
+  })
+})
