+/**
+ * Locate the support runtime that carries the payload's package manager and Node launcher. Its directory
+ * sits beside the payload in a build tree (`<target>/dsh` and `<target>/runtime`), beside the archive in a
+ * packaged ASAR build, and above the payload in the unpacked packaged build Linux uses because a standalone
+ * Node cannot read ASAR (`<resources>/app/dsh` and `<resources>/runtime`). The layouts are otherwise
+ * indistinguishable, so the payload that exists decides.
+ * @param runtimeDir - Materialized dsh package tree.
+ * @returns Directory holding `primary-runtime`.
+ */
+function resolveSupportDir(runtimeDir: string): string {
+  const archive = runtimeArchivePath(runtimeDir)
+  const candidates = [join(dirname(archive ?? runtimeDir), 'runtime'), resolve(runtimeDir, '..', '..', 'runtime')]
+  return candidates.find(candidate => existsSync(join(candidate, 'primary-runtime', 'dependencies', 'pnpm', 'bin', 'pnpm.mjs')))
+    ?? candidates[0]!
+}
